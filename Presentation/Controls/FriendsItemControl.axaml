<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:Chat_App.Infrastructure.Models;assembly=Infrastructure"
             mc:Ignorable="d"
             x:Class="Chat_App.Presentation.Controls.FriendsItemControl"
             x:DataType="models:LocalConversation"
             d:DesignWidth="220"
             d:DesignHeight="60">

    <Border Name="HighlightBorder" CornerRadius="8" Padding="4 2">
        <Grid Height="56" ColumnDefinitions="Auto,*,Auto,Auto">
            <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource AvatarBrush}"
                    VerticalAlignment="Center" Margin="4 0 10 0">
                <Panel>
                    <TextBlock Text="{Binding Initial}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AvatarTextBrush}"/>
                    <Ellipse Width="10" Height="10"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Bottom"
                             Margin="0 0 1 1"
                             Stroke="White"
                             StrokeThickness="1.5"
                             Fill="{DynamicResource OnlineBrush}"
                             IsVisible="{Binding PeerIsOnline}"/>
                    <Ellipse Width="10" Height="10"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Bottom"
                             Margin="0 0 1 1"
                             Stroke="White"
                             StrokeThickness="1.5"
                             Fill="{DynamicResource OfflineBrush}"
                             IsVisible="{Binding IsOffline}"/>
                </Panel>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{Binding Title}"
                           FontWeight="SemiBold"
                           FontSize="14"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Subtitle}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="4"
                        VerticalAlignment="Top"
                        Margin="4 8 4 0">
                <TextBlock Text="{Binding PinGlyph}" FontSize="12"/>
                <TextBlock Text="{Binding MuteGlyph}" FontSize="12"/>
            </StackPanel>

            <!-- 未读徽标：免打扰会话灰色（UnreadBadgeColor），普通会话红色，保持提示层级 -->
            <Border Grid.Column="3"
                    CornerRadius="10"
                    Background="{Binding UnreadBadgeColor}"
                    MinWidth="18"
                    Height="18"
                    Padding="4 0"
                    VerticalAlignment="Center"
                    Margin="4 0 4 0"
                    IsVisible="{Binding UnreadBadgeVisibility}">
                <TextBlock Text="{Binding UnreadBadgeText}"
                           Foreground="{DynamicResource OnAccentBrush}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
