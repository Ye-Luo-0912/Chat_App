<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Chat_App.Presentation.ViewModels.Chat"
             xmlns:controls="clr-namespace:Chat_App.Presentation.Controls"
             xmlns:conv="clr-namespace:Chat_App.Presentation.Converters"
             xmlns:models="clr-namespace:Chat_App.Infrastructure.Models;assembly=Infrastructure"
             mc:Ignorable="d"
             x:Class="Chat_App.Presentation.Views.Chat.ChatView"
             x:Name="Root"
             x:DataType="vm:ChatViewModel">

    <UserControl.Resources>
        <conv:CountIsEmptyConverter x:Key="CountIsEmpty"/>
    </UserControl.Resources>

    <!-- 聊天主布局：左侧好友列表 + 右侧消息区域 -->
    <Grid ColumnDefinitions="240,*" Background="{DynamicResource ChatBgBrush}">

        <!-- ===== 左侧：好友列表面板 ===== -->
        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                CornerRadius="0"
                Padding="0">
            <DockPanel>
                <!-- 顶部：标题和搜索栏 -->
                <StackPanel DockPanel.Dock="Top" Background="{DynamicResource SurfaceAltBrush}" Spacing="8">
                    <!-- 标题栏 -->
                    <Border Background="{DynamicResource AccentBrush}" Padding="16 12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="聊天"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource OnAccentBrush}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        VerticalAlignment="Center">
                                <Button Content="＋新建群聊"
                                        Command="{Binding OpenCreateGroupPanelCommand}"
                                        Padding="8 4"
                                        FontSize="12"
                                        Background="{DynamicResource AccentStrongBrush}"
                                        Foreground="{DynamicResource OnAccentBrush}"
                                        CornerRadius="6"
                                        VerticalAlignment="Center"/>
                                <Button Content="通话"
                                        Command="{Binding StartCallCommand}"
                                        CommandParameter="{Binding SelectedConversation}"
                                        Padding="8 4"
                                        FontSize="12"
                                        Background="{DynamicResource AccentBrush}"
                                        Foreground="{DynamicResource OnAccentBrush}"
                                        CornerRadius="6"
                                        VerticalAlignment="Center"/>
                                <Ellipse Width="8" Height="8"
                                         Fill="{Binding ConnectionIndicatorBrush}"
                                         VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ConnectionStatusText}"
                                           FontSize="12"
                                           Foreground="{DynamicResource OnAccentMutedBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 创建群聊面板 -->
                    <Border Margin="12 4 12 8"
                            Background="{DynamicResource InfoSoftBrush}"
                            CornerRadius="8"
                            Padding="12 10"
                            IsVisible="{Binding IsCreatingGroup}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="创建群聊"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource InfoTextStrongBrush}"/>
                            <TextBox PlaceholderText="群聊名称"
                                     Text="{Binding GroupTitleInput, Mode=TwoWay}"
                                     FontSize="13"
                                     Padding="8 6"
                                     CornerRadius="6"
                                     Background="{DynamicResource SurfaceBrush}"
                                     BorderBrush="{DynamicResource InfoBorderBrush}"/>
                            <TextBlock Text="选择成员"
                                       FontSize="12"
                                       Foreground="{DynamicResource InfoTextBrush}"/>
                            <ListBox ItemsSource="{Binding GroupCreationCandidates}"
                                     MaxHeight="180"
                                     Background="{DynamicResource SurfaceBrush}"
                                     CornerRadius="6"
                                     Padding="4">
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Padding" Value="2"/>
                                        <Setter Property="Focusable" Value="False"/>
                                    </Style>
                                </ListBox.Styles>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="vm:GroupMemberSelectionItem">
                                        <CheckBox Content="{Binding DisplayName}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  FontSize="13"
                                                  Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="创建"
                                        Command="{Binding CreateGroupCommand}"
                                        Padding="14 5"
                                        FontSize="13"
                                        Background="{DynamicResource AccentBrush}"
                                        Foreground="{DynamicResource OnAccentBrush}"
                                        CornerRadius="6"/>
                                <Button Content="取消"
                                        Command="{Binding CancelCreateGroupCommand}"
                                        Padding="14 5"
                                        FontSize="13"
                                        Background="Transparent"
                                        Foreground="{DynamicResource DangerTextBrush}"
                                        CornerRadius="6"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 搜索框 -->
                    <TextBox Margin="12 4 12 8"
                             PlaceholderText="搜索本地好友..."
                             Text="{Binding SearchText, Mode=TwoWay}"
                             FontSize="13"
                             Padding="8 6"
                             CornerRadius="6"
                             BorderBrush="{DynamicResource DividerBrush}"
                             Background="{DynamicResource InputBrush}">
                         <TextBox.InnerLeftContent>
                             <TextBlock Text="🔍" Margin="8 0 4 0" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="12"/>
                         </TextBox.InnerLeftContent>
                    </TextBox>

                    <!-- 转发选目标横幅 -->
                    <Border Margin="12 0 12 8"
                            Background="{DynamicResource InfoSoftBrush}"
                            CornerRadius="8"
                            Padding="10 8"
                            IsVisible="{Binding IsSelectingForwardTarget}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding ForwardHintText}"
                                       FontSize="13"
                                       Foreground="{DynamicResource InfoTextBrush}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                            <Button Grid.Column="1"
                                    Content="取消"
                                    Command="{Binding CancelForwardCommand}"
                                    Padding="10 4"
                                    FontSize="12"
                                    Background="Transparent"
                                    Foreground="{DynamicResource DangerTextBrush}"
                                    VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- 会话列表 (使用 FilteredConversations 绑定) + 空态占位 -->
                <Panel>
                    <ListBox x:Name="ConversationList"
                             ItemsSource="{Binding FilteredConversations}"
                             SelectedItem="{Binding SelectedConversation, Mode=TwoWay}"
                             Background="{DynamicResource SurfaceBrush}"
                             Padding="4"
                             BorderThickness="0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="models:LocalConversation">
                                <controls:FriendsItemControl Margin="0 1">
                                    <controls:FriendsItemControl.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="置顶"
                                                      Command="{Binding #Root.((vm:ChatViewModel)DataContext).PinConversationCommand}"
                                                      CommandParameter="{Binding}"/>
                                            <MenuItem Header="取消置顶"
                                                      Command="{Binding #Root.((vm:ChatViewModel)DataContext).UnpinConversationCommand}"
                                                      CommandParameter="{Binding}"/>
                                            <Separator/>
                                            <MenuItem Header="消息免打扰"
                                                      Command="{Binding #Root.((vm:ChatViewModel)DataContext).MuteConversationCommand}"
                                                      CommandParameter="{Binding}"/>
                                            <MenuItem Header="关闭免打扰"
                                                      Command="{Binding #Root.((vm:ChatViewModel)DataContext).UnmuteConversationCommand}"
                                                      CommandParameter="{Binding}"/>
                                            <Separator/>
                                            <MenuItem Header="归档会话"
                                                      Command="{Binding #Root.((vm:ChatViewModel)DataContext).ArchiveConversationCommand}"
                                                      CommandParameter="{Binding}"/>
                                            <MenuItem Header="恢复归档"
                                                      Command="{Binding #Root.((vm:ChatViewModel)DataContext).UnarchiveConversationCommand}"
                                                      CommandParameter="{Binding}"/>
                                            <Separator/>
                                            <MenuItem Header="查看成员"
                                                      IsVisible="{Binding IsGroup}"
                                                      Command="{Binding #Root.((vm:ChatViewModel)DataContext).ShowGroupMembersCommand}"
                                                      CommandParameter="{Binding}"/>
                                            <MenuItem Header="退出群聊"
                                                      IsVisible="{Binding IsGroup}"
                                                      Command="{Binding #Root.((vm:ChatViewModel)DataContext).LeaveGroupCommand}"
                                                      CommandParameter="{Binding}"/>
                                            <Separator IsVisible="{Binding IsGroup}"/>
                                            <MenuItem Header="删除会话"
                                                      Command="{Binding #Root.((vm:ChatViewModel)DataContext).DeleteConversationCommand}"
                                                      CommandParameter="{Binding}"/>
                                        </ContextMenu>
                                    </controls:FriendsItemControl.ContextMenu>
                                </controls:FriendsItemControl>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 空态：无会话（含搜索无结果）时给明确反馈，替代纯空白 -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="10"
                                IsVisible="{Binding FilteredConversations.Count, Converter={StaticResource CountIsEmpty}}">
                        <TextBlock Text="📭"
                                   FontSize="36"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="暂无会话"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Panel>
            </DockPanel>
        </Border>

        <!-- 左右分隔线 -->
        <Border Grid.Column="0"
                HorizontalAlignment="Right"
                Width="1"
                Background="{DynamicResource DividerBrush}"/>

        <!-- ===== 右侧：消息区域 + 群成员面板 ===== -->
        <Grid Grid.Column="1" ColumnDefinitions="*,300">
            <Panel Grid.Column="0">
                <!-- 来电横幅（被叫侧收到 invite） -->
                <Border Margin="12 12 12 0"
                        Padding="12 10"
                        VerticalAlignment="Top"
                        Background="{DynamicResource InfoSoftBrush}"
                        BorderBrush="{DynamicResource InfoBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        IsVisible="{Binding IsIncomingCall}">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <StackPanel Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                            <TextBlock Text="来电"
                                       FontSize="12"
                                       Foreground="{DynamicResource InfoTextStrongBrush}"/>
                            <TextBlock Text="{Binding IncomingCallerName}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                            <!-- 群组（Mesh）通话：成员数呈现（如 "3 人通话"）；1:1 为空隐藏。 -->
                            <TextBlock Text="{Binding CallParticipantsText}"
                                       FontSize="12"
                                       IsVisible="{Binding CallParticipantsText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       Foreground="{DynamicResource InfoTextStrongBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="接听"
                                Command="{Binding AcceptCallCommand}"
                                Margin="8 0 8 0"
                                Padding="14 4"
                                FontSize="12"
                                Background="{DynamicResource AccentBrush}"
                                Foreground="{DynamicResource OnAccentBrush}"
                                CornerRadius="6"
                                VerticalAlignment="Center"/>
                        <Button Grid.Column="2"
                                Content="拒绝"
                                Command="{Binding RejectCallCommand}"
                                Padding="14 4"
                                FontSize="12"
                                Background="{DynamicResource DangerBrush}"
                                Foreground="{DynamicResource OnAccentBrush}"
                                CornerRadius="6"
                                VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- 通话中横幅 -->
                <Border Margin="12 12 12 0"
                        Padding="12 10"
                        VerticalAlignment="Top"
                        Background="{DynamicResource InfoSoftBrush}"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        IsVisible="{Binding IsCallActive}">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CallStatusText}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource InfoTextStrongBrush}"
                                       VerticalAlignment="Center"/>
                            <!-- 群组（Mesh）通话：成员数呈现（如 "3 人通话"）；1:1 为空隐藏。 -->
                            <TextBlock Text="{Binding CallParticipantsText}"
                                       FontSize="12"
                                       IsVisible="{Binding CallParticipantsText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       Foreground="{DynamicResource InfoTextStrongBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="挂断"
                                Command="{Binding EndCallCommand}"
                                Padding="14 4"
                                FontSize="12"
                                Background="{DynamicResource DangerBrush}"
                                Foreground="{DynamicResource OnAccentBrush}"
                                CornerRadius="6"
                                VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- 未选中好友时的空状态提示 -->
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="12"
                            Opacity="0.5"
                            IsVisible="{Binding CurrentMessage, Converter={x:Static ObjectConverters.IsNull}}">
                    <TextBlock Text="💬"
                               FontSize="48"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="选择左侧会话开始聊天"
                               FontSize="16"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- 消息视图 -->
                <ContentControl Content="{Binding CurrentMessage}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                IsVisible="{Binding CurrentMessage, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            </Panel>

            <!-- 群成员面板 -->
            <Border Grid.Column="1"
                    Background="{DynamicResource SurfaceAltBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="1 0 0 0"
                    IsVisible="{Binding IsShowingGroupMembers}">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Background="{DynamicResource SurfaceSubtleBrush}"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="0 0 0 1"
                            Padding="12 10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding GroupMembersTitle}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1"
                                    Content="✕"
                                    Command="{Binding CloseGroupMembersCommand}"
                                    Padding="8 4"
                                    FontSize="12"
                                    Background="Transparent"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <ListBox x:Name="GroupMembersList"
                             ItemsSource="{Binding GroupMembers}"
                             Background="Transparent"
                             Padding="8"
                             BorderThickness="0">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0 2"/>
                                <Setter Property="Focusable" Value="False"/>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="vm:GroupMemberUiItem">
                                <Border Background="{DynamicResource SurfaceBrush}"
                                        CornerRadius="8"
                                        Padding="10 8">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0"
                                                Width="34"
                                                Height="34"
                                                CornerRadius="17"
                                                Background="{DynamicResource AvatarBrush}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Initial}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AvatarTextBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1"
                                                    Margin="10 0"
                                                    Spacing="2"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding RoleText}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="（我）"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           IsVisible="{Binding IsSelf}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    Spacing="4"
                                                    VerticalAlignment="Center">
                                            <Button Content="设为管理员"
                                                    Command="{Binding #Root.((vm:ChatViewModel)DataContext).ToggleGroupMemberRoleCommand}"
                                                    CommandParameter="{Binding}"
                                                    FontSize="11"
                                                    Padding="8 3"
                                                    Background="{DynamicResource InfoSoftBrush}"
                                                    Foreground="{DynamicResource InfoTextBrush}"
                                                    CornerRadius="4"
                                                    IsVisible="{Binding CanPromote}"/>
                                            <Button Content="取消管理员"
                                                    Command="{Binding #Root.((vm:ChatViewModel)DataContext).ToggleGroupMemberRoleCommand}"
                                                    CommandParameter="{Binding}"
                                                    FontSize="11"
                                                    Padding="8 3"
                                                    Background="{DynamicResource WarnSoftBrush}"
                                                    Foreground="{DynamicResource WarnTextBrush}"
                                                    CornerRadius="4"
                                                    IsVisible="{Binding CanDemote}"/>
                                            <Button Content="移除"
                                                    Command="{Binding #Root.((vm:ChatViewModel)DataContext).RemoveGroupMemberCommand}"
                                                    CommandParameter="{Binding}"
                                                    FontSize="11"
                                                    Padding="8 3"
                                                    Background="{DynamicResource DangerSoftBrush}"
                                                    Foreground="{DynamicResource DangerTextBrush}"
                                                    CornerRadius="4"
                                                    IsVisible="{Binding CanRemove}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 添加成员区 -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="12 8" Spacing="8">
                        <Button Content="＋ 添加成员"
                                Command="{Binding ToggleAddGroupMembersCommand}"
                                FontSize="13"
                                Padding="10 6"
                                Background="{DynamicResource AccentBrush}"
                                Foreground="{DynamicResource OnAccentBrush}"
                                CornerRadius="6"/>
                        <Border Background="{DynamicResource SurfaceBrush}"
                                CornerRadius="8"
                                Padding="10 8"
                                IsVisible="{Binding IsAddingGroupMembers}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="选择好友"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <ListBox ItemsSource="{Binding GroupAddCandidates}"
                                         MaxHeight="140"
                                         Background="{DynamicResource SurfaceBrush}"
                                         Padding="2">
                                    <ListBox.Styles>
                                        <Style Selector="ListBoxItem">
                                            <Setter Property="Padding" Value="2"/>
                                            <Setter Property="Focusable" Value="False"/>
                                        </Style>
                                    </ListBox.Styles>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="vm:GroupMemberSelectionItem">
                                            <CheckBox Content="{Binding DisplayName}"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      FontSize="13"
                                                      Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button Content="确认添加"
                                        Command="{Binding AddGroupMembersCommand}"
                                        FontSize="12"
                                        Padding="10 4"
                                        Background="{DynamicResource AccentStrongBrush}"
                                        Foreground="{DynamicResource OnAccentBrush}"
                                        CornerRadius="6"/>
                            </StackPanel>
                        </Border>
                        <Button Content="解散群聊"
                                Command="{Binding DissolveGroupCommand}"
                                CommandParameter="{Binding SelectedConversation}"
                                IsVisible="{Binding IsGroupOwner}"
                                FontSize="13"
                                Padding="10 6"
                                Background="{DynamicResource DangerBrush}"
                                Foreground="{DynamicResource OnAccentBrush}"
                                CornerRadius="6"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
