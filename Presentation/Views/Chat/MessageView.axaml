<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Chat_App.Presentation.ViewModels.Chat"
             xmlns:models="clr-namespace:Chat_App.Models"
             xmlns:dto="clr-namespace:Core.Models.DTO;assembly=Core"
             xmlns:conv="clr-namespace:Chat_App.Presentation.Converters"
             mc:Ignorable="d"
             d:DesignWidth="600"
             d:DesignHeight="500"
             x:Class="Chat_App.Presentation.Views.Chat.MessageView"
             x:Name="Root"
             x:DataType="vm:MessageViewModel"
             Background="White">

    <UserControl.Resources>
        <conv:BoolToAlignmentConverter x:Key="BoolToAlignment"/>
        <conv:BoolToColumnConverter x:Key="BoolToColumn"/>
        <conv:BoolToBrushConverter x:Key="BoolToBrush"
                                   TrueBrush="#3B82F6"
                                   FalseBrush="#E5E7EB"/>
        <conv:LongToBoolConverter x:Key="LongToBool"/>
        <conv:MessageStatusMatchConverter x:Key="StatusMatch"/>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0"
                Background="#F8FAFC"
                BorderBrush="#E5E7EB"
                BorderThickness="0 0 0 1"
                Padding="16 12">
            <StackPanel Spacing="2">
                <TextBlock Text="{Binding PeerTitle}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#111827"/>
                <TextBlock Text="{Binding PeerStatusText}"
                           FontSize="12"
                           Foreground="#6B7280"/>
                <TextBlock Text="{Binding TypingStatusText}"
                           FontSize="12"
                           Foreground="#3B82F6"
                           IsVisible="{Binding IsPeerTyping}"/>
            </StackPanel>
        </Border>

        <!-- 八: 删除外层 ScrollViewer，改由 ListBox 自身滚动系统驱动虚拟化。
             外层 ScrollViewer 会给列表无限高度，导致一次性创建全部容器，抵消虚拟化。 -->
        <ListBox Grid.Row="1"
                 x:Name="MessageList"
                 ItemsSource="{Binding Messages}"
                 Background="Transparent"
                 BorderThickness="0"
                 SelectionMode="Single"
                 Padding="16 0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Focusable" Value="False"/>
                </Style>
                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
            </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="models:Message">
                        <Grid HorizontalAlignment="{Binding IsSentByMe, Converter={StaticResource BoolToAlignment}}"
                              ColumnDefinitions="*,Auto"
                              Margin="0 4">
                            <StackPanel Grid.Column="{Binding IsSentByMe, Converter={StaticResource BoolToColumn}}"
                                      Margin="5"
                                      HorizontalAlignment="{Binding IsSentByMe, Converter={StaticResource BoolToAlignment}}">
                                <Border Background="{Binding IsSentByMe, Converter={StaticResource BoolToBrush}}"
                                        CornerRadius="16"
                                        Padding="14 10"
                                        MaxWidth="360"
                                        BoxShadow="0 1 4 #10000000">
                                    <Border.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuItem Header="回复"
                                                      Command="{Binding #Root.((vm:MessageViewModel)DataContext).ReplyToMessageCommand}"
                                                      CommandParameter="{Binding}"/>
                                            <MenuItem Header="转发"
                                                      Command="{Binding #Root.((vm:MessageViewModel)DataContext).ForwardMessageCommand}"
                                                      CommandParameter="{Binding}"/>
                                            <MenuItem Header="编辑"
                                                      IsVisible="{Binding IsSentByMe}"
                                                      Command="{Binding #Root.((vm:MessageViewModel)DataContext).BeginEditMessageCommand}"
                                                      CommandParameter="{Binding}"/>
                                            <MenuItem Header="撤回"
                                                      IsVisible="{Binding IsSentByMe}"
                                                      Command="{Binding #Root.((vm:MessageViewModel)DataContext).RecallMessageCommand}"
                                                      CommandParameter="{Binding}"/>
                                            <MenuItem Header="重试发送"
                                                      IsVisible="{Binding Status, Converter={StaticResource StatusMatch}, ConverterParameter=Failed}"
                                                      Command="{Binding #Root.((vm:MessageViewModel)DataContext).RetryMessageCommand}"
                                                      CommandParameter="{Binding}"/>
                                            <MenuItem Header="取消发送"
                                                      IsVisible="{Binding Status, Converter={StaticResource StatusMatch}, ConverterParameter='Queued,Sending'}"
                                                      Command="{Binding #Root.((vm:MessageViewModel)DataContext).CancelSendCommand}"
                                                      CommandParameter="{Binding}"/>
                                            <MenuItem Header="查看失败原因"
                                                      IsVisible="{Binding IsSendFailed}"
                                                      Command="{Binding #Root.((vm:MessageViewModel)DataContext).ShowFailureReasonCommand}"
                                                      CommandParameter="{Binding}"/>
                                            <MenuItem Header="删除失败消息"
                                                      IsVisible="{Binding IsSendFailed}"
                                                      Command="{Binding #Root.((vm:MessageViewModel)DataContext).DeleteFailedMessageCommand}"
                                                      CommandParameter="{Binding}"/>
                                        </MenuFlyout>
                                    </Border.ContextFlyout>
                                    <StackPanel Spacing="6">
                                        <Border Background="#F1F5F9"
                                                CornerRadius="8"
                                                Padding="8 6"
                                                IsVisible="{Binding HasReply}">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="回复"
                                                           FontSize="11"
                                                           Foreground="#64748B"/>
                                                <TextBlock Text="{Binding ReplyDisplayText}"
                                                           FontSize="12"
                                                           Foreground="#334155"
                                                           TextWrapping="Wrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxLines="2"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#EEF2FF"
                                                CornerRadius="8"
                                                Padding="8 6"
                                                IsVisible="{Binding HasForward}">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="转发"
                                                           FontSize="11"
                                                           Foreground="#6366F1"/>
                                                <TextBlock Text="{Binding ForwardDisplayText}"
                                                           FontSize="12"
                                                           Foreground="#334155"
                                                           TextWrapping="Wrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxLines="2"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="{Binding DisplayContent}"
                                                   FontSize="14"
                                                   TextWrapping="Wrap"
                                                   Foreground="#1A1A2E"
                                                   IsVisible="{Binding DisplayContent, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        <ItemsControl ItemsSource="{Binding Attachments}"
                                                      IsVisible="{Binding HasAttachments}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="dto:AttachmentRefDto">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                                                        <TextBlock Text="📎"
                                                                   FontSize="13"
                                                                   VerticalAlignment="Center"/>
                                                        <Button Classes="attachment-link"
                                                                HorizontalAlignment="Left"
                                                                Padding="0"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Cursor="Hand"
                                                                Command="{Binding #Root.((vm:MessageViewModel)DataContext).DownloadAttachmentCommand}"
                                                                CommandParameter="{Binding}">
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       FontSize="13"
                                                                       TextDecorations="Underline"
                                                                       Foreground="#0F172A"
                                                                       TextWrapping="Wrap"/>
                                                        </Button>
                                                        <TextBlock Text="{Binding SizeBytes, StringFormat='{}{0:N0} B'}"
                                                                   FontSize="11"
                                                                   Foreground="Gray"
                                                                   VerticalAlignment="Center"
                                                                   IsVisible="{Binding SizeBytes, Converter={StaticResource LongToBool}}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="已编辑"
                                                   FontSize="10"
                                                   Foreground="#94A3B8"
                                                   IsVisible="{Binding IsEdited}"
                                                   HorizontalAlignment="Right"/>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    Spacing="4"
                                                    Margin="0 2 0 0">
                                            <TextBlock Text="{Binding StatusGlyphText}"
                                                       FontSize="10"
                                                       Foreground="{Binding StatusGlyphColor}"
                                                       IsVisible="{Binding StatusGlyphVisibility}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Timestamp, StringFormat='HH:mm'}"
                                                       FontSize="10"
                                                       Foreground="#999"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0 1 0 0"
                Padding="16 12">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto"
                      IsVisible="{Binding HasReplyDraft}">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="正在回复"
                                   FontSize="11"
                                   Foreground="#64748B"/>
                        <TextBlock Text="{Binding ReplyDraftPreview}"
                                   FontSize="12"
                                   Foreground="#334155"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="取消"
                            Command="{Binding ClearReplyDraftCommand}"
                            Padding="10 4"
                            FontSize="12"
                            Background="Transparent"
                            Foreground="#B91C1C"/>
                </Grid>

                <Grid ColumnDefinitions="*,Auto"
                      IsVisible="{Binding HasEditDraft}">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="正在编辑"
                                   FontSize="11"
                                   Foreground="#64748B"/>
                        <TextBlock Text="{Binding EditDraftPreview}"
                                   FontSize="12"
                                   Foreground="#334155"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="取消"
                            Command="{Binding ClearEditDraftCommand}"
                            Padding="10 4"
                            FontSize="12"
                            Background="Transparent"
                            Foreground="#B91C1C"/>
                </Grid>

                <ItemsControl ItemsSource="{Binding PendingAttachments}"
                              IsVisible="{Binding HasPendingAttachment}"
                              Margin="0,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:PendingAttachment">
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                                <TextBlock Text="📎"
                                           FontSize="12"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding FileName}"
                                           FontSize="12"
                                           Foreground="#475569"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <Button Content="✕"
                                        Command="{Binding #Root.((vm:MessageViewModel)DataContext).ClearPendingAttachmentCommand}"
                                        CommandParameter="{Binding}"
                                        Padding="6,2"
                                        FontSize="12"
                                        Background="Transparent"
                                        Foreground="#B91C1C"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <Button Grid.Column="0"
                            Content="附件"
                            Command="{Binding AttachFileCommand}"
                            Margin="0 0 8 0"
                            Padding="12 10"
                            MinWidth="56"
                            CornerRadius="12"
                            Background="#F3F4F6"
                            Foreground="#111827"
                            VerticalAlignment="Bottom"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBox Text="{Binding NewMessage, Mode=TwoWay}"
                                 PlaceholderText="输入消息..."
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalAlignment="Center"
                                 FontSize="14"
                                 AcceptsReturn="True"
                                 MaxHeight="100">
                            <TextBox.KeyBindings>
                                <KeyBinding Command="{Binding SendMessageCommand}"
                                            Gesture="Ctrl+Enter"/>
                            </TextBox.KeyBindings>
                        </TextBox>
                        <ProgressBar Maximum="100"
                                     Value="{Binding UploadProgress}"
                                     Height="4"
                                     Margin="0 4 0 0"
                                     IsVisible="{Binding IsUploading}"/>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Content="取消"
                            Command="{Binding CancelUploadCommand}"
                            Margin="8 0 0 0"
                            Padding="12 10"
                            IsVisible="{Binding IsUploading}"
                            CornerRadius="12"
                            Background="#FEE2E2"
                            Foreground="#991B1B"
                            VerticalAlignment="Bottom"/>

                    <Button Grid.Column="3"
                            Content="{Binding SendButtonText}"
                            Command="{Binding SendMessageCommand}"
                            Margin="10 0 0 0"
                            Padding="20 10"
                            MinWidth="72"
                            CornerRadius="12"
                            Background="#3B82F6"
                            Foreground="White"
                            FontWeight="SemiBold"
                            VerticalAlignment="Bottom"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
