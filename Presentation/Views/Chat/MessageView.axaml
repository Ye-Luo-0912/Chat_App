<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Chat_App.Presentation.ViewModels.Chat"
             xmlns:models="clr-namespace:Chat_App.Models"
             xmlns:wire="clr-namespace:ChatApp.Shared.Protocol.Tcp;assembly=ChatApp.Protocol.Tcp"
             xmlns:conv="clr-namespace:Chat_App.Presentation.Converters"
             xmlns:auto="using:Avalonia.Automation"
             mc:Ignorable="d"
             d:DesignWidth="600"
             d:DesignHeight="500"
             x:Class="Chat_App.Presentation.Views.Chat.MessageView"
             x:Name="Root"
             x:DataType="vm:MessageViewModel"
             Background="{DynamicResource SurfaceBrush}">

    <UserControl.Resources>
        <conv:BoolToAlignmentConverter x:Key="BoolToAlignment"/>
        <conv:BoolToColumnConverter x:Key="BoolToColumn"/>
        <!-- 气泡底色：我方 = 浅蓝调 BubbleOut，对方 = 灰调 BubbleIn。
             改为浅色底后气泡内深色文字/状态字形（含蓝色"已读 ✓✓"）始终可读，
             语音播放按钮也不再与气泡同色相融。 -->
        <conv:BoolToBrushConverter x:Key="BoolToBrush"
                                   TrueBrush="{StaticResource BubbleOutBrush}"
                                   FalseBrush="{StaticResource BubbleInBrush}"/>
        <conv:LongToBoolConverter x:Key="LongToBool"/>
        <conv:MessageStatusMatchConverter x:Key="StatusMatch"/>
        <conv:CountIsEmptyConverter x:Key="CountIsEmpty"/>
        <conv:PathToBitmapConverter x:Key="PathToBitmap"/>
        <conv:PathToBitmapConverter x:Key="PathToBitmapPreview" MaxCacheEntries="4"/>
        <conv:VoicePlaybackStateConverter x:Key="VoicePlaybackState"/>
        <conv:VoiceWaveformConverter x:Key="VoiceWaveform"/>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0 0 0 1"
                Padding="16 12">
            <StackPanel Spacing="2">
                <TextBlock Text="{Binding PeerTitle}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding PeerStatusText}"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Text="{Binding TypingStatusText}"
                           FontSize="12"
                           Foreground="{DynamicResource AccentBrush}"
                           IsVisible="{Binding IsPeerTyping}"/>
            </StackPanel>
        </Border>

        <!-- 八: 删除外层 ScrollViewer，改由 ListBox 自身滚动系统驱动虚拟化。
             外层 ScrollViewer 会给列表无限高度，导致一次性创建全部容器，抵消虚拟化。 -->
        <Panel Grid.Row="1">
            <ListBox x:Name="MessageList"
                     ItemsSource="{Binding Messages}"
                     Background="Transparent"
                     BorderThickness="0"
                     SelectionMode="Single"
                     Padding="16 0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Focusable" Value="False"/>
                    </Style>
                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="models:Message">
                        <Grid HorizontalAlignment="{Binding IsSentByMe, Converter={StaticResource BoolToAlignment}}"
                              ColumnDefinitions="*,Auto"
                              Margin="0 4">
                            <StackPanel Grid.Column="{Binding IsSentByMe, Converter={StaticResource BoolToColumn}}"
                                      Margin="5"
                                      HorizontalAlignment="{Binding IsSentByMe, Converter={StaticResource BoolToAlignment}}">
                                <Border Background="{Binding IsSentByMe, Converter={StaticResource BoolToBrush}}"
                                        CornerRadius="16"
                                        Padding="14 10"
                                        MaxWidth="360"
                                        BoxShadow="0 1 4 #10000000">
                                    <Border.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuItem Header="回复"
                                                      Command="{Binding #Root.((vm:MessageViewModel)DataContext).ReplyToMessageCommand}"
                                                      CommandParameter="{Binding}"/>
                                            <MenuItem Header="转发"
                                                      Command="{Binding #Root.((vm:MessageViewModel)DataContext).ForwardMessageCommand}"
                                                      CommandParameter="{Binding}"/>
                                            <MenuItem Header="编辑"
                                                      IsVisible="{Binding IsSentByMe}"
                                                      Command="{Binding #Root.((vm:MessageViewModel)DataContext).BeginEditMessageCommand}"
                                                      CommandParameter="{Binding}"/>
                                            <MenuItem Header="撤回"
                                                      IsVisible="{Binding IsSentByMe}"
                                                      Command="{Binding #Root.((vm:MessageViewModel)DataContext).RecallMessageCommand}"
                                                      CommandParameter="{Binding}"/>
                                            <MenuItem Header="重试发送"
                                                      IsVisible="{Binding Status, Converter={StaticResource StatusMatch}, ConverterParameter=Failed}"
                                                      Command="{Binding #Root.((vm:MessageViewModel)DataContext).RetryMessageCommand}"
                                                      CommandParameter="{Binding}"/>
                                            <MenuItem Header="取消发送"
                                                      IsVisible="{Binding Status, Converter={StaticResource StatusMatch}, ConverterParameter='Queued,Sending'}"
                                                      Command="{Binding #Root.((vm:MessageViewModel)DataContext).CancelSendCommand}"
                                                      CommandParameter="{Binding}"/>
                                            <MenuItem Header="查看失败原因"
                                                      IsVisible="{Binding IsSendFailed}"
                                                      Command="{Binding #Root.((vm:MessageViewModel)DataContext).ShowFailureReasonCommand}"
                                                      CommandParameter="{Binding}"/>
                                            <MenuItem Header="删除失败消息"
                                                      IsVisible="{Binding IsSendFailed}"
                                                      Command="{Binding #Root.((vm:MessageViewModel)DataContext).DeleteFailedMessageCommand}"
                                                      CommandParameter="{Binding}"/>
                                        </MenuFlyout>
                                    </Border.ContextFlyout>
                                    <StackPanel Spacing="6">
                                        <Border Background="{DynamicResource SurfaceSubtleBrush}"
                                                CornerRadius="8"
                                                Padding="8 6"
                                                IsVisible="{Binding HasReply}">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="回复"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding ReplyDisplayText}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextWrapping="Wrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxLines="2"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource InfoSoftBrush}"
                                                CornerRadius="8"
                                                Padding="8 6"
                                                IsVisible="{Binding HasForward}">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="转发"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource InfoTextBrush}"/>
                                                <TextBlock Text="{Binding ForwardDisplayText}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextWrapping="Wrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxLines="2"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="{Binding DisplayContent}"
                                                   FontSize="14"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   IsVisible="{Binding DisplayContent, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        <!-- 图片附件内联缩略图条：后台预取成功后逐个显示，点击下载/保存原图 -->
                                        <ItemsControl ItemsSource="{Binding ImageThumbnails}"
                                                      IsVisible="{Binding HasImageThumbnails}"
                                                      Margin="0 2">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="models:ImageThumbnailItem">
                                                    <Button MinWidth="0"
                                                            MinHeight="0"
                                                            Padding="0"
                                                            Margin="0 2 4 2"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Cursor="Hand"
                                                            IsVisible="{Binding HasThumbnail}"
                                                            Command="{Binding #Root.((vm:MessageViewModel)DataContext).PreviewImageCommand}"
                                                            CommandParameter="{Binding}">
                                                        <Border CornerRadius="8"
                                                                ClipToBounds="True"
                                                                BorderBrush="{DynamicResource DividerBrush}"
                                                                BorderThickness="1">
                                                            <Image Source="{Binding ThumbnailPath, Converter={StaticResource PathToBitmap}}"
                                                                   Width="88"
                                                                   Height="88"
                                                                   Stretch="UniformToFill"/>
                                                        </Border>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl ItemsSource="{Binding Attachments}"
                                                      IsVisible="{Binding HasAttachments}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="wire:TcpAttachmentRef">
                                                    <StackPanel>
                                                        <!-- 语音附件气泡（VOICE-MSG-2） -->
                                                        <StackPanel Orientation="Horizontal"
                                                                Spacing="8"
                                                                Margin="0,2"
                                                                IsVisible="{Binding IsVoice}">
                                                        <Button Padding="0"
                                                                Width="34"
                                                                Height="34"
                                                                CornerRadius="17"
                                                                Background="{DynamicResource AccentBrush}"
                                                                Foreground="{DynamicResource OnAccentBrush}"
                                                                Cursor="Hand"
                                                                Command="{Binding #Root.((vm:MessageViewModel)DataContext).PlayVoiceCommand}"
                                                                CommandParameter="{Binding}">
                                                        <auto:AutomationProperties.Name>
                                                            <MultiBinding Converter="{StaticResource VoicePlaybackState}"
                                                                          ConverterParameter="Label">
                                                                <Binding Path="#Root.((vm:MessageViewModel)DataContext).IsVoicePlaying"/>
                                                                <Binding Path="#Root.((vm:MessageViewModel)DataContext).PlayingVoiceAttachmentId"/>
                                                                <Binding Path="AttachmentId"/>
                                                            </MultiBinding>
                                                        </auto:AutomationProperties.Name>
                                                        <TextBlock FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       VerticalAlignment="Center">
                                                                <TextBlock.Text>
                                                                    <MultiBinding Converter="{StaticResource VoicePlaybackState}"
                                                                                  ConverterParameter="Icon">
                                                                        <Binding Path="#Root.((vm:MessageViewModel)DataContext).IsVoicePlaying"/>
                                                                        <Binding Path="#Root.((vm:MessageViewModel)DataContext).PlayingVoiceAttachmentId"/>
                                                                        <Binding Path="AttachmentId"/>
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                        </Button>
                                                        <StackPanel Spacing="3" VerticalAlignment="Center">
                                                            <!-- 波形柱状图（VOICE-MSG-2）：peaks 非空时渲染（降采样 24 柱，
                                                                 柱高 = peak/255 × MaxBarHeight，语义色 TextSecondaryBrush）；
                                                                 peaks 缺省/空时隐藏，降级为下方进度条。 -->
                                                            <ItemsControl Width="130"
                                                                          Height="24"
                                                                          HorizontalAlignment="Left"
                                                                          IsVisible="{Binding VoiceWaveformPeaks, Converter={StaticResource VoiceWaveform}, ConverterParameter=HasPeaks}"
                                                                          ItemsSource="{Binding VoiceWaveformPeaks, Converter={StaticResource VoiceWaveform}}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel Orientation="Horizontal" Spacing="2"/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Width="3"
                                                                                CornerRadius="1.5"
                                                                                VerticalAlignment="Center"
                                                                                Background="{DynamicResource TextSecondaryBrush}"
                                                                                Height="{Binding}"/>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <!-- 播放进度条：无波形时为唯一进度反馈；有波形时隐藏（保留绑定不破坏）。 -->
                                                            <ProgressBar Width="130"
                                                                         Height="4"
                                                                         Maximum="1"
                                                                         Minimum="0"
                                                                         IsVisible="{Binding VoiceWaveformPeaks, Converter={StaticResource VoiceWaveform}, ConverterParameter=LacksPeaks}">
                                                                <ProgressBar.Value>
                                                                    <MultiBinding Converter="{StaticResource VoicePlaybackState}"
                                                                                  ConverterParameter="Progress">
                                                                        <Binding Path="#Root.((vm:MessageViewModel)DataContext).IsVoicePlaying"/>
                                                                        <Binding Path="#Root.((vm:MessageViewModel)DataContext).PlayingVoiceAttachmentId"/>
                                                                        <Binding Path="AttachmentId"/>
                                                                        <Binding Path="#Root.((vm:MessageViewModel)DataContext).VoicePlaybackProgress"/>
                                                                    </MultiBinding>
                                                                </ProgressBar.Value>
                                                            </ProgressBar>
                                                            <!-- 时长文字：未播放显示总时长；播放中切换为"已播 / 总时长"实时进度 -->
                                                            <Panel MinHeight="15">
                                                                <TextBlock FontSize="11"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                                           VerticalAlignment="Center">
                                                                    <TextBlock.IsVisible>
                                                                        <MultiBinding Converter="{StaticResource VoicePlaybackState}"
                                                                                      ConverterParameter="IsNotThisPlaying">
                                                                            <Binding Path="#Root.((vm:MessageViewModel)DataContext).IsVoicePlaying"/>
                                                                            <Binding Path="#Root.((vm:MessageViewModel)DataContext).PlayingVoiceAttachmentId"/>
                                                                            <Binding Path="AttachmentId"/>
                                                                        </MultiBinding>
                                                                    </TextBlock.IsVisible>
                                                                    <TextBlock.Text>
                                                                        <Binding Path="VoiceDurationMs"
                                                                                 TargetNullValue="0:00">
                                                                            <Binding.Converter>
                                                                                <conv:VoiceDurationConverter/>
                                                                            </Binding.Converter>
                                                                        </Binding>
                                                                    </TextBlock.Text>
                                                                </TextBlock>
                                                                <TextBlock FontSize="11"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                                           VerticalAlignment="Center"
                                                                           Text="{Binding #Root.((vm:MessageViewModel)DataContext).VoicePlaybackDisplayText}">
                                                                    <TextBlock.IsVisible>
                                                                        <MultiBinding Converter="{StaticResource VoicePlaybackState}"
                                                                                      ConverterParameter="IsThisPlaying">
                                                                            <Binding Path="#Root.((vm:MessageViewModel)DataContext).IsVoicePlaying"/>
                                                                            <Binding Path="#Root.((vm:MessageViewModel)DataContext).PlayingVoiceAttachmentId"/>
                                                                            <Binding Path="AttachmentId"/>
                                                                        </MultiBinding>
                                                                    </TextBlock.IsVisible>
                                                                </TextBlock>
                                                            </Panel>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <!-- 普通附件链接 -->
                                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2"
                                                                IsVisible="{Binding !IsVoice}">
                                                        <TextBlock Text="📎"
                                                                   FontSize="13"
                                                                   VerticalAlignment="Center"/>
                                                        <Button Classes="attachment-link"
                                                                HorizontalAlignment="Left"
                                                                Padding="0"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Cursor="Hand"
                                                                auto:AutomationProperties.Name="{Binding FileName, StringFormat='下载附件 {0}', TargetNullValue=下载附件}"
                                                                Command="{Binding #Root.((vm:MessageViewModel)DataContext).DownloadAttachmentCommand}"
                                                                CommandParameter="{Binding}">
                                                            <TextBlock Text="{Binding FileName, TargetNullValue=附件}"
                                                                       FontSize="13"
                                                                       TextDecorations="Underline"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       TextWrapping="Wrap"/>
                                                        </Button>
                                                        <TextBlock Text="{Binding SizeBytes, StringFormat='{}{0:N0} B'}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                                   VerticalAlignment="Center"
                                                                   IsVisible="{Binding SizeBytes, Converter={StaticResource LongToBool}}"/>
                                                    </StackPanel>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="已编辑"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   IsVisible="{Binding IsEdited}"
                                                   HorizontalAlignment="Right"/>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    Spacing="4"
                                                    Margin="0 2 0 0">
                                            <TextBlock Text="{Binding StatusGlyphText}"
                                                       FontSize="10"
                                                       Foreground="{Binding StatusGlyphColor}"
                                                       IsVisible="{Binding StatusGlyphVisibility}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Timestamp, StringFormat='HH:mm'}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 空态：会话历史渲染完成后仍无消息时显示（加载期间不显示，避免切换会话闪烁） -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10"
                        IsVisible="{Binding IsMessageListEmpty}">
                <TextBlock Text="💬"
                           FontSize="40"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="还没有消息，打个招呼吧"
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Panel>

        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0 1 0 0"
                Padding="16 12">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto"
                      IsVisible="{Binding HasReplyDraft}">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="正在回复"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding ReplyDraftPreview}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="取消"
                            Command="{Binding ClearReplyDraftCommand}"
                            Padding="10 4"
                            FontSize="12"
                            Background="Transparent"
                            Foreground="{DynamicResource DangerTextBrush}"/>
                </Grid>

                <Grid ColumnDefinitions="*,Auto"
                      IsVisible="{Binding HasEditDraft}">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="正在编辑"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding EditDraftPreview}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="取消"
                            Command="{Binding ClearEditDraftCommand}"
                            Padding="10 4"
                            FontSize="12"
                            Background="Transparent"
                            Foreground="{DynamicResource DangerTextBrush}"/>
                </Grid>

                <ItemsControl ItemsSource="{Binding PendingAttachments}"
                              IsVisible="{Binding HasPendingAttachment}"
                              Margin="0,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:PendingAttachment">
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                                <TextBlock Text="📎"
                                           FontSize="12"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding FileName}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <Button Content="✕"
                                        auto:AutomationProperties.Name="{Binding FileName, StringFormat='移除附件 {0}', TargetNullValue=移除附件}"
                                        Command="{Binding #Root.((vm:MessageViewModel)DataContext).ClearPendingAttachmentCommand}"
                                        CommandParameter="{Binding}"
                                        Padding="6,2"
                                        FontSize="12"
                                        Background="Transparent"
                                        Foreground="{DynamicResource DangerTextBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                    <Button Grid.Column="0"
                            Content="录音"
                            Command="{Binding StartRecordingCommand}"
                            Margin="0 0 8 0"
                            Padding="12 10"
                            MinWidth="56"
                            CornerRadius="12"
                            Background="{DynamicResource InputBrush}"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            VerticalAlignment="Bottom"
                            IsVisible="{Binding !IsRecording}"/>

                    <Button Grid.Column="1"
                            Content="附件"
                            Command="{Binding AttachFileCommand}"
                            Margin="0 0 8 0"
                            Padding="12 10"
                            MinWidth="56"
                            CornerRadius="12"
                            Background="{DynamicResource InputBrush}"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            VerticalAlignment="Bottom"
                            IsVisible="{Binding !IsRecording}"/>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBox Text="{Binding NewMessage, Mode=TwoWay}"
                                 PlaceholderText="输入消息..."
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalAlignment="Center"
                                 FontSize="14"
                                 AcceptsReturn="True"
                                 MaxHeight="100"
                                 IsVisible="{Binding !IsRecording}">
                            <TextBox.KeyBindings>
                                <KeyBinding Command="{Binding SendMessageCommand}"
                                            Gesture="Ctrl+Enter"/>
                            </TextBox.KeyBindings>
                        </TextBox>
                        <!-- 上传进度条：仅上传中显示，避免空闲/完成后残留一条无意义(或满格)的进度条 -->
                        <ProgressBar Maximum="100"
                                     Value="{Binding UploadProgress}"
                                     Height="4"
                                     Margin="0 4 0 0"
                                     IsVisible="{Binding IsUploading}"/>
                        <!-- 录音状态：时长实时更新（VOICE-MSG-2）。 -->
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    IsVisible="{Binding IsRecording}">
                            <Ellipse Width="10" Height="10" Fill="{DynamicResource DangerBrush}"/>
                            <TextBlock Text="{Binding RecordingDurationText}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="录音中，点击「发送语音」发送"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="3"
                            Content="取消"
                            Command="{Binding CancelUploadCommand}"
                            Margin="8 0 0 0"
                            Padding="12 10"
                            IsVisible="{Binding IsUploading}"
                            CornerRadius="12"
                            Background="{DynamicResource DangerSoftBrush}"
                            Foreground="{DynamicResource DangerTextBrush}"
                            VerticalAlignment="Bottom"/>

                    <Button Grid.Column="3"
                            Content="取消录音"
                            Command="{Binding CancelRecordingCommand}"
                            Margin="8 0 0 0"
                            Padding="12 10"
                            IsVisible="{Binding IsRecording}"
                            CornerRadius="12"
                            Background="{DynamicResource DangerSoftBrush}"
                            Foreground="{DynamicResource DangerTextBrush}"
                            VerticalAlignment="Bottom"/>

                    <Button Grid.Column="4"
                            Content="{Binding SendButtonText}"
                            Command="{Binding SendMessageCommand}"
                            Margin="10 0 0 0"
                            Padding="20 10"
                            MinWidth="72"
                            CornerRadius="12"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="{DynamicResource OnAccentBrush}"
                            FontWeight="SemiBold"
                            VerticalAlignment="Bottom"
                            IsVisible="{Binding !IsRecording}"/>

                    <Button Grid.Column="4"
                            Content="发送语音"
                            Command="{Binding SendRecordingCommand}"
                            Margin="10 0 0 0"
                            Padding="20 10"
                            MinWidth="72"
                            CornerRadius="12"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="{DynamicResource OnAccentBrush}"
                            FontWeight="SemiBold"
                            VerticalAlignment="Bottom"
                            IsVisible="{Binding IsRecording}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 大图预览弹层：居中浮层，点击外部/关闭按钮收起，保存复用下载→另存为链路 -->
        <Popup IsOpen="{Binding IsPreviewOpen, Mode=TwoWay}"
               IsLightDismissEnabled="True"
               Placement="Center">
            <Border Background="#F0000000"
                    CornerRadius="12"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    Padding="16"
                    MaxWidth="960"
                    MaxHeight="720">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="8"
                                Margin="0 0 0 10">
                        <TextBlock Text="{Binding PreviewImageName}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0 0 12 0"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="320"/>
                        <Button Content="保存"
                                Command="{Binding SavePreviewedImageCommand}"
                                Padding="16 8"
                                CornerRadius="8"
                                Background="{DynamicResource AccentBrush}"
                                Foreground="{DynamicResource OnAccentBrush}"
                                FontWeight="SemiBold"/>
                        <Button Content="关闭"
                                Command="{Binding ClosePreviewCommand}"
                                Padding="16 8"
                                CornerRadius="8"
                                Background="{DynamicResource InputBrush}"
                                Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <Grid DockPanel.Dock="Bottom">
                        <Image Source="{Binding PreviewImagePath, Converter={StaticResource PathToBitmapPreview}}"
                               Stretch="Uniform"
                               MaxWidth="920"
                               MaxHeight="620"
                               IsVisible="{Binding HasPreviewImage}"/>
                        <TextBlock Text="图片加载中…"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding !HasPreviewImage}"/>
                    </Grid>
                </DockPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
