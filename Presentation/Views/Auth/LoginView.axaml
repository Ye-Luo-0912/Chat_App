<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Chat_App.Presentation.ViewModels.Auth"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="520"
             x:Class="Chat_App.Presentation.Views.Auth.LoginView"
             x:DataType="vm:LoginViewModel"
             Background="Transparent">

    <Border CornerRadius="16"
            Background="#FFFBFE"
            BoxShadow="0 8 40 #22C0667A"
            Margin="18"
            ClipToBounds="True">
        <Grid RowDefinitions="Auto,*,Auto">

            <!-- ===== 头部渐变 + 关闭按钮 + 头像 ===== -->
            <Panel Grid.Row="0" Height="168">
                <Panel.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#FDDDE6" Offset="0" />
                        <GradientStop Color="#FDEEF5" Offset="0.6" />
                        <GradientStop Color="#FFF8FB" Offset="1" />
                    </LinearGradientBrush>
                </Panel.Background>

                <!-- 关闭按钮 -->
                <Button x:Name="CloseButton"
                        Width="28" Height="28"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="10"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Opacity="0.55">
                    <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                              Width="12" Height="12"
                              Foreground="#9D6676"/>
                </Button>

                <!-- 应用标题 -->
                <TextBlock Text="青言"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#C9527A"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           Margin="0,22,0,0"
                           Opacity="0.85"/>

                <!-- 头像圆圈 -->
                <Border Width="82" Height="82"
                        CornerRadius="41"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,-41"
                        HorizontalAlignment="Center"
                        BoxShadow="0 4 14 #35C06080">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Color="#F9A8C9" Offset="0"/>
                            <GradientStop Color="#F472B6" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <PathIcon Data="M12,19.2C9.5,19.2 7.29,17.92 6,16C6.03,14 10,12.9 12,12.9C14,12.9 17.97,14 18,16C16.71,17.92 14.5,19.2 12,19.2M12,5A3,3 0 0,1 15,8A3,3 0 0,1 12,11A3,3 0 0,1 9,8A3,3 0 0,1 12,5M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12C22,6.47 17.5,2 12,2Z"
                              Width="46" Height="46"
                              Foreground="White"/>
                </Border>
            </Panel>

            <!-- ===== 表单内容 ===== -->
            <StackPanel Grid.Row="1" Spacing="18" Margin="36,66,36,8">

                <!-- 欢迎文字 -->
                <StackPanel Spacing="2" HorizontalAlignment="Center">
                    <TextBlock Text="欢迎回来"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#5C2B3E"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="请登录您的账号"
                               Foreground="#B08090"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- 用户名输入框 -->
                <TextBox Text="{Binding Username}"
                         PlaceholderText="用户名"
                         Height="46"
                         FontSize="15"
                         CornerRadius="8"
                         BorderBrush="#FFE4E6"
                         BorderThickness="1"
                         Background="#FFF1F2"
                         Foreground="#881337"
                         SelectionBrush="#FDA4AF"
                         CaretBrush="#E11D48"/>

                <!-- 密码输入框 -->
                <TextBox Text="{Binding Password}"
                         PlaceholderText="密  码"
                         PasswordChar="●"
                         Height="46"
                         FontSize="15"
                         CornerRadius="8"
                         BorderBrush="#FFE4E6"
                         BorderThickness="1"
                         Background="#FFF1F2"
                         Foreground="#881337"
                         SelectionBrush="#FDA4AF"
                         CaretBrush="#E11D48"/>

                <!-- 错误提示 -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#D05073"
                           TextWrapping="Wrap"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>

            <!-- ===== 底部按钮 ===== -->
            <StackPanel Grid.Row="2" Spacing="14" Margin="36,4,36,32">
                <Button Content="登  录"
                        Command="{Binding LoginCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Foreground="White"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Padding="0 13"
                        CornerRadius="10"
                        Cursor="Hand">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                            <GradientStop Color="#F06495" Offset="0"/>
                            <GradientStop Color="#E05580" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>
                <Button Content="注册账号"
                        Command="{Binding GoToRegisterCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        Foreground="#C06080"
                        FontSize="13"
                        HorizontalAlignment="Center"
                        Opacity="0.8"
                        Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
